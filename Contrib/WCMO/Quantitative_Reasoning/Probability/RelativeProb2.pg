## DESCRIPTION
## Quantitative Reasoning: Relative frequency probability - rolling a 4-sided die
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Sample Space')
## DBsection('Outcomes & events')
## Date('10/27/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('probability','relative frequency','empirical probability')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextFraction.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

$num = random(100,150,10);

@count = ();

$count[0] = sprintf("%.0f",(random(21,31,2)/100*$num));
$count[1] = sprintf("%.0f",(random(22,32,2)/100*$num));
$count[2] = sprintf("%.0f",(random(19,29,2)/100*$num));
$count[3] = $num - $count[0] - $count[1] - $count[2];

Context('Fraction-NoDecimals');
@answer = ();

foreach my $i (0..3) {
$answer[$i] = Compute("$count[$i] / $num");
}

BEGIN_PGML
Suppose we roll a 4-sided die [$num] times and get the following results:
- Rolling a 1 occurs [$count[0]] times;
- Rolling a 2 occurs [$count[1]] times;
- Rolling a 3 occurs [$count[2]] times;
- Rolling a 4 occurs [$count[3]] times.

Compute the relative frequency probabilities for each of those events (give each answer as a reduced fraction):
- [`P(1)\approx`] [_]{$answer[0]->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}

- [`P(2)\approx`] [_]{$answer[1]->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}

- [`P(3)\approx`] [_]{$answer[2]->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}
- [`P(4)\approx`] [_]{$answer[3]->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}


END_PGML

ENDDOCUMENT();
