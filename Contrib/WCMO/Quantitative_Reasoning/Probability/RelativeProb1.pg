## KEYWORDS()

## DBsubject('')
## DBchapter('')
## DBsection('')
## Date('10/27/2024')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')

DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextFraction.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

$num = random(100,150,10);

@count = ();

$count[0] = sprintf("%.0f",(random(21,31,2)/100*$num));
$count[1] = sprintf("%.0f",(random(46,54,2)/100*$num));
$count[2] = $num - $count[0] - $count[1];

Context('Fraction-NoDecimals');
@answer = ();

foreach my $i (0..2) {
$answer[$i] = Compute("$count[$i] / $num");
}

BEGIN_PGML
Suppose we toss two coins [$num] times and get the following results:
- 0 heads occurs [$count[0]] times;
- 1 head occurs [$count[1]] times;
- 2 heads occurs [$count[2]] times.

Compute the relative frequency probabilities for each of those events (give each answers as a reduced fraction):
- [`P(\text{0 heads})\approx`] [_]{$answer[0]->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}

- [`P(\text{1 head})\approx`] [_]{$answer[1]->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}

- [`P(\text{2 heads})\approx`] [_]{$answer[2]->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}


END_PGML

ENDDOCUMENT();
