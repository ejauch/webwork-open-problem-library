## DESCRIPTION
## Quantitative Reasoning: At least once rule - coin tosses
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Sample Space')
## DBsection('Independence')
## Date('11/2/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('probability','at least once','complement')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextFraction.pl",
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

$num = random(5,8,1);

@side = ("head","tail");

$text = $side[random(0,1,1)];


Context('Fraction-NoDecimals');

$ans = Compute("1-1/2**$num")->reduce();



# HINTS (added from FA24 WeBWorK answers): messages for common wrong answers.
@atLeastHints = (
    Compute("1/2^$num") =>
        "That is the probability of getting no ${text}s at all. 'At least one' is everything else, "
      . "so subtract it from 1.",
    Compute("1/2") =>
        "That is the probability for one coin. With $num coins you have more chances, so find the "
      . "probability of no ${text}s and subtract it from 1.",
);

BEGIN_PGML
Find the probability of getting at least one [$text] when you toss [$num] coins?

[`P(\text{at least one [$text]})=`] [_]{$ans->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)->withPostFilter(AnswerHints(@atLeastHints))}{15}


END_PGML

ENDDOCUMENT();
