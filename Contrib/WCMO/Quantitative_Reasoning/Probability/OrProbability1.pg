## DESCRIPTION
## Quantitative Reasoning: Or probability - mutually exclusive die outcomes
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Sample Space')
## DBsection('Probability: direct computation, inclusion/exclusion')
## Date('11/2/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('probability','or rule','mutually exclusive')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextFraction.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

@sides = (4,6,8,10,12,20);

$size = $sides[random(0,$#sides,1)];

@side =(random(1,$size,1),random(1,$size,1));

while ($side[1] == $side[0]) {
$side[1] = random(1,$size,1);
}

Context('Fraction-NoDecimals');


$ans = Compute("2/$size")->reduce();


BEGIN_PGML
Suppose you roll a [$size]-sided die. What is the probability of rolling either a [$side[0]] or a [$side[1]]?


[`P([$side[0]]\text{ or }[$side[1]])=`] [_]{$ans->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}


END_PGML

ENDDOCUMENT();
