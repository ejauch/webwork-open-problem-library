## DESCRIPTION
## Quantitative Reasoning: Or probability - card value or suit (overlapping events)
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Sample Space')
## DBsection('Probability: direct computation, inclusion/exclusion')
## Date('11/2/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('probability','or rule','overlapping events','cards')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextFraction.pl",
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

@pics = ("jack","queen","king","ace");
@suits = ("heart","diamond","spade","club");

$par = random(0,1,1);
if ($par == 0) {
$card = random(2,10,1);
}
else {
$card = $pics[random(0,$#pics,1)];
}

# "an ace" and "an 8", "a" for everything else. Compare as strings (eq), since
# $card can be a word: with == every word counts as 0, so "jack" == "ace" is true.
$article = ($card eq "ace" || $card eq "8") ? "an" : "a";
$cardstate = "$article $card";

$suit = $suits[random(0,3,1)];


Context('Fraction-NoDecimals');

$ans = Compute("(4+13-1)/52");


# HINTS (added from FA24 WeBWorK answers): messages for common wrong answers.
@orHints = (
    Compute("17/52") =>
        "It looks like you counted the $card of ${suit}s twice. Subtract the overlap: "
      . "P(A or B) = P(A) + P(B) - P(A and B).",
);

BEGIN_PGML
Imagine you have a standard deck of 52 cards. What is the probability that you draw [$cardstate] or a [$suit]?

[`P(\text{[$cardstate] or a [$suit]})=`] [_]{$ans->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)->withPostFilter(AnswerHints(@orHints))}{15}


END_PGML

ENDDOCUMENT();
