## KEYWORDS()

## DBsubject('')
## DBchapter('')
## DBsection('')
## Date('11/02/2024')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')

DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextFraction.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

@pics = ("jack","queen","king","ace");
@suits = ("heart","diamond","spade","club");

$par = random(0,1,1);
if ($par == 0) {
$card = random(2,10,1);
}
else {
$card = $pics[random(0,$#pics,1)];
}

$suit = $suits[random(0,3,1)];


Context('Fraction-NoDecimals');

$ans = Compute("(4+13-1)/52");


BEGIN_PGML
Imagine you have a standard deck of 52 cards. What is the probality that you draw a [$card] or a [$suit]?

[`P(\text{a [$card] or a [$suit]})=`] [_]{$ans->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}


END_PGML

ENDDOCUMENT();
