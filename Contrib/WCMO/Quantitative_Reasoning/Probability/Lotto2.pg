## DESCRIPTION
## Quantitative Reasoning: Combinations and probability - chance a specific group of students is picked for a team
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Sample Space')
## DBsection('Probability: direct computation, inclusion/exclusion')
## Date('11/2/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('probability','combinations','scientific notation')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextScientificNotation.pl",
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$nums = random(5,8,1);

$numsless = $nums - 1;

$total = random(25,35,1);

$comb =  C($total,$nums);

$prob =  1 / $comb;

# HINTS messages for common wrong answers.
# (Built before the context changes, so the count is graded as an ordinary number.)
$combCmp = Real($comb)->cmp->withPostFilter(AnswerHints(
    Real(P($total, $nums)) =>
        "That counts the students in the order they are picked. A team is the same team no matter "
      . "what order its members were chosen, so use combinations.",
    Real($total**$nums) =>
        "A student cannot be picked twice, so the number of choices goes down after each pick, "
      . "and the order of the picks does not matter.",
));

# The probability is entered in scientific notation with 3 significant digits
# (2 digits after the decimal point in the mantissa).
Context("ScientificNotation");

Context()->flags->set(
    snDigits => 2,
    snTrimZeros => 0,
    snMinDigits => 2,
    snMaxDigits => 2,
);
Context()->flags->set(tolType => 'digits', tolerance => 3, tolTruncation => 1);

$ans =  ScientificNotation($prob);


BEGIN_PGML
Imagine you are in a class with [$total] total students (yourself included) and the professor randomly selects [$nums] students to represent the class in a competition.

How many different teams are possible? [_]{$combCmp}

What is the probability that you and your [$numsless] friends ([$nums] students in total) are the team the professor picks? [_]{$ans} (Round this answer to 3 significant digits.)
END_PGML

ENDDOCUMENT();
