## DESCRIPTION
## Quantitative Reasoning: At least once rule - repeated die rolls
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Sample Space')
## DBsection('Independence')
## Date('11/2/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('probability','at least once','complement')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextFraction.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

@die = (4,6,8,10,12,20);

$size = $die[random(0,$#die,1)];

$side = random(1,$size,1);

$num = random(4,8,1);

Context('Fraction-NoDecimals');

$ans = Compute("1-(1-1/$size)**$num")->reduce();



BEGIN_PGML
Find the probability of getting at least one [$side] when you roll a fair [$size]-sided die [$num] times?

[`P(\text{at least one [$side]})=`] [_]{$ans->cmp(
    studentsMustReduceFractions => 1,
    reduceFractions => 1,
    allowMixedNumbers => 0
)}{15}


END_PGML

ENDDOCUMENT();
