## DESCRIPTION
## Quantitative Reasoning: Rule of 70 - approximate growth rate from a doubling time
## ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Exponential and logarithmic expressions and functions')
## DBsection('Applications and models - population growth')
## Date('11/15/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('exponential growth','doubling time','rule of 70')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$time = random(20,60,1);

@ans = ();

$ans[0] = 70/$time;


BEGIN_PGML
If a population has a doubling time of [$time] years, then the growth rate would be approximately [_]{DecimalPlacesCmp($ans[0], 2)}% per year (rounded to the nearest hundredth).

END_PGML

ENDDOCUMENT();
