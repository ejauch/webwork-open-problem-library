DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$time = random(20,60,1);

@ans = ();

$ans[0] = sprintf("%0.2f",70/$time);


BEGIN_PGML
If a population has a doubling time of [$time] years, then the growth rate would be approximately [_]{$ans[0]}% per year (rounded to the nearest hundredth).

END_PGML

ENDDOCUMENT();
