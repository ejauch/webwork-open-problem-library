## DESCRIPTION
## Quantitative Reasoning: Exponential growth - classify the change and compute values
## ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Exponential and logarithmic expressions and functions')
## DBsection('Applications and models - population growth')
## Date('11/15/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('exponential growth','growth and decay','linear vs exponential')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$rate = random(2,8,1);

$amount = random(250,450,25);

$interval = random(2,5,1);

@time = ();

$time[0] = $interval;

$time[1] = random(2*$interval,4*$interval,$interval);

$time[2] = random(5*$interval,7*$interval,$interval);

@ans = ();

$dropgd = DropDown([ 'Growth', 'Decay'],
    'Growth', placeholder => '- Select one -');
    
$droptype = DropDown([ 'Exponential', 'Linear'],
    'Exponential', placeholder => '- Select one -');

foreach my $i (0..2) {
$ans[$i] = $amount * ((100 + $rate)/100)**($time[$i]/$interval);
}

BEGIN_PGML
The amount of bacteria in a container is increasing at [$rate]% every [$interval] hours. If there are originally [$amount] bacteria in the container, answer the following:

- Is this growth or decay? [_]{$dropgd}

- Is this exponential or linear change? [_]{$droptype}

- How many bacteria are in the container after [$time[0]] hours? [_]{DecimalPlacesCmp($ans[0], 0)}{5} (round to the nearest whole number)

- How many bacteria are in the container after [$time[1]] hours? [_]{DecimalPlacesCmp($ans[1], 0)}{5} (round to the nearest whole number)

- How many bacteria are in the container after [$time[2]] hours? [_]{DecimalPlacesCmp($ans[2], 0)}{5} (round to the nearest whole number)
END_PGML

ENDDOCUMENT();
