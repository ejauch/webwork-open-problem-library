## DESCRIPTION
## Quantitative Reasoning: Half-life - amount of a medication remaining
## ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Exponential and logarithmic expressions and functions')
## DBsection('Applications and models - general')
## Date('11/15/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('exponential decay','half-life')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$hlife = random(1.1,2.5,0.2);

$amount = random(10,46,2);

@time = ();

$time[0] = 1;

$time[1] = sprintf("%0.0f",random(1.1*$hlife,3*$hlife,0.1*$hlife));
$time[1] = 2 if $time[1] < 2;

$time[2] = sprintf("%0.0f",random(3.1*$hlife,5*$hlife,0.1*$hlife));

@ans = ();

foreach my $i (0..2) {
$ans[$i] = $amount*2**(-1*$time[$i]/$hlife);
}


# HINTS (added from FA24 WeBWorK answers): messages for common wrong answers.
$roundMsg = "It looks like you rounded the exponent (the number of half-lives). Keep all of its "
          . "digits, or enter the whole calculation at once, and round only the final answer.";
$wholeMsg = "It looks like you counted only whole half-lives. The number of half-lives (time divided "
          . "by the half-life) does not have to be a whole number; use it exactly as the exponent.";
$closeMsg = "Your answer is close, but not exact. Keep all of the digits of the exponent and round "
          . "only the final answer.";
@amountHints = ();
foreach my $i (0 .. 2) {
    my $e = $time[$i]/$hlife;
    $amountHints[$i] = [
        [ $amount*0.5**Round($e, 2), $roundMsg ],
        [ $amount*0.5**Round($e, 1), $roundMsg ],
        [ $amount*0.5**int($e),      $wholeMsg ],
        [ $amount*(1 - $e/2),
          "It looks like you treated the decay as linear. The amount of medication decreases exponentially: "
        . "multiply by (1/2) once for each half-life, so the amount is (starting amount)*(1/2)^(time/half-life)." ],
        [ $amount*0.5**(1/$e),
          "Check the exponent. It is (time elapsed)/(half-life), not the other way around." ],
    ];
}

BEGIN_PGML
A new medication has a half-life of [$hlife] hours in the human body. If a pill contains [$amount] grams of the medication, find the amount in grams for the following situations to the nearest tenth gram:

- After [$time[0]] hour there are [_]{DecimalPlacesCmp($ans[0], 1, hints => $amountHints[0], nearMiss => 0.01, nearMissMessage => $closeMsg)} grams.

- After [$time[1]] hours there are [_]{DecimalPlacesCmp($ans[1], 1, hints => $amountHints[1], nearMiss => 0.01, nearMissMessage => $closeMsg)} grams.

- After [$time[2]] hours there are [_]{DecimalPlacesCmp($ans[2], 1, hints => $amountHints[2], nearMiss => 0.01, nearMissMessage => $closeMsg)} grams.
END_PGML

ENDDOCUMENT();
