DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@animals = ("cat", "dog", "elephant", "giraffe", "lion", "tiger", "bear", "wolf", "zebra", "rabbit");

$animal = $animals[random(0,$#animals,1)];

$rate = random(25,85,2);

$time = Compute("log(1/2)/log(1-$rate/100)")->reduce();

@ans = ();

$ans[0] = sprintf("%0.2f",$time);


BEGIN_PGML
An unkown radioative element is decaying at a rate of [$rate]% per hour. The exact half-life would be [_]{$ans[0]} hour(s) (rounded to the nearest hundredth).
END_PGML

ENDDOCUMENT();
