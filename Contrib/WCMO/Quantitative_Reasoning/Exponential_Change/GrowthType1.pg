## DESCRIPTION
## 
## ENDDESCRIPTION

## KEYWORDS()

## DBsubject('')
## DBchapter('')
## DBsection('')
## Date('11/15/2024')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')

DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$rate = random(12,50,2);

$amount = $rate * random(15,30,3) + random(10,30,5);

$interval = random(4,8,1);

@time = ();

$time[0] = $interval;

$time[1] = random(2*$interval,4*$interval,$interval);

$time[2] = random(5*$interval,7*$interval,$interval);

@ans = ();

$dropgd = DropDown([ 'Growth', 'Decay'],
    'Growth', placeholder => '- Select one -');
    
$droptype = DropDown([ 'Exponential', 'Linear'],
    'Linear', placeholder => '- Select one -');

foreach my $i (0..2) {
$ans[$i] = $amount + $rate*$time[$i]/$interval;
}

BEGIN_PGML
The number of new members of a club increases by [$rate] students every [$interval] years. If there are originaly [$amount] students in the club, answer the following:

- Is this growth or decay? [_]{$dropgd}

- Is this exponential or linear change? [_]{$droptype}

- How many students are there after [$time[0]] years? [_]{$ans[0]}{5}

- How many students are there after [$time[1]] years? [_]{$ans[1]}{5}

- How many students are there after [$time[2]] years? [_]{$ans[2]}{5}
END_PGML

ENDDOCUMENT();
