## DESCRIPTION
## Quantitative Reasoning: Doubling time - projecting a town population
## ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Exponential and logarithmic expressions and functions')
## DBsection('Applications and models - population growth')
## Date('11/15/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('exponential growth','doubling time','population')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$pop = random(9,15,1)*1000;

$time = random(12,34,2);

@year = ();

$year[0] = random(1980,2010,5);

$year[1] = $year[0] + random($time,4*$time,5);

$year[2] = $year[1] + random($time,4*$time,5);

@ans = ();

foreach my $i (0..1) {
$j = $i + 1;
$ans[$i] = $pop*2**(($year[$j]-$year[0])/$time);
}

BEGIN_PGML
Imagine that the population of a small town is [$pop] in [$year[0]]. If we know that population doubles every [$time] years, find the following populations (rounded to the nearest whole number):

- The population of the town would be [_]{DecimalPlacesCmp($ans[0], 0)}{5} in [$year[1]].

- The population of the town would be [_]{DecimalPlacesCmp($ans[1], 0)}{5} in [$year[2]].
END_PGML

ENDDOCUMENT();
