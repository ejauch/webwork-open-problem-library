## DESCRIPTION
## Quantitative Reasoning: Exact doubling time from a percentage growth rate
## ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Exponential and logarithmic expressions and functions')
## DBsection('Applications and models - population growth')
## Date('11/15/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('exponential growth','doubling time','logarithms')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@animals = ("cats", "dogs", "elephants", "giraffes", "lions", "tigers", "bears", "wolves", "zebras", "rabbits");

$animal = $animals[random(0,$#animals,1)];

$rate = random(25,85,2);

$time = Compute("log(2)/log(1+$rate/100)")->reduce();

@ans = ();

$ans[0] = $time;


BEGIN_PGML
A population of [$animal] is growing at a rate of [$rate]% per month. The exact doubling time would be [_]{DecimalPlacesCmp($ans[0], 2)} months (rounded to the nearest hundredth).
END_PGML

ENDDOCUMENT();
