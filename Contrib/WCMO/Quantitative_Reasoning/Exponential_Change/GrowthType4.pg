## DESCRIPTION
## Quantitative Reasoning: Exponential decay - classify the change and compute values
## ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Exponential and logarithmic expressions and functions')
## DBsection('Applications and models - general')
## Date('11/15/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('exponential decay','depreciation','growth and decay','linear vs exponential')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "contextCurrency.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;


Context("Currency");

$rate = random(10,16,1);

$amount = Currency(random(900,1200,50));

$interval = random(2,5,1);

@time = ();

$time[0] = $interval;

$time[1] = random(2*$interval,4*$interval,$interval);

$time[2] = random(5*$interval,7*$interval,$interval);

@ans = ();

$dropgd = DropDown([ 'Growth', 'Decay'],
    'Decay', placeholder => '- Select one -');
    
$droptype = DropDown([ 'Exponential', 'Linear'],
    'Exponential', placeholder => '- Select one -');

foreach my $i (0..2) {
$ans[$i] = Currency($amount * ((100 - $rate)/100)**($time[$i]/$interval));
}

BEGIN_PGML
The value of a laptop decreases at a rate of [$rate]% every [$interval] years. If the laptop is originally worth [$amount], answer the following (round values to the nearest cent):

- Is this growth or decay? [_]{$dropgd}

- Is this exponential or linear change? [_]{$droptype}

- What is the value of the laptop after [$time[0]] years? [_]{DecimalPlacesCmp($ans[0], 2)}{5}

- What is the value of the laptop after [$time[1]] years? [_]{DecimalPlacesCmp($ans[1], 2)}{5} 

- What is the value of the laptop after [$time[2]] years? [_]{DecimalPlacesCmp($ans[2], 2)}{5}
END_PGML

ENDDOCUMENT();
