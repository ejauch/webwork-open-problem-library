## DESCRIPTION
## Quantitative Reasoning: Rule of 70 - approximate doubling time from a growth rate
## ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Exponential and logarithmic expressions and functions')
## DBsection('Applications and models - population growth')
## Date('11/15/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('exponential growth','doubling time','rule of 70')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$rate = random(1.1,5.5,0.2);

@ans = ();

$ans[0] = 70/$rate;


BEGIN_PGML
After years of intervention, a certain endangered animal population has an approximate growth rate of about [$rate]% per year. If this is the case, then the doubling time would be approximately [_]{DecimalPlacesCmp($ans[0], 0)} years (rounded to the nearest whole number).

END_PGML

ENDDOCUMENT();
