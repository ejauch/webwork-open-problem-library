## DESCRIPTION
## Quantitative Reasoning: Rule of 70 - approximate doubling time of an investment
## ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Exponential and logarithmic expressions and functions')
## DBsection('Applications and models - general')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('exponential growth','doubling time','rule of 70','investment')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@accounts = ("a retirement account", "a college savings fund", "an index fund", "a certificate of deposit", "a savings bond");
$account = $accounts[random(0,$#accounts,1)];

$rate = random(2.5,9.5,0.5);

@ans = ();

$ans[0] = 70/$rate;


BEGIN_PGML
Money in [$account] grows at an average rate of about [$rate]% per year. Using the rule of 70, the money will double in approximately [_]{DecimalPlacesCmp($ans[0], 0)} years (rounded to the nearest whole number).

END_PGML

ENDDOCUMENT();
