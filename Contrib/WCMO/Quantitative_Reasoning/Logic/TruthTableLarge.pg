## DESCRIPTION
## Quantitative Reasoning: Truth table - three propositions with negations, conjunctions, and disjunctions
## ENDDESCRIPTION

## DBsubject('Set theory and logic')
## DBchapter('Propositional logic')
## DBsection('Truth tables')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('logic','truth table','negation','conjunction','disjunction')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

$parameter = random(1,3,1); # parameter for choosing one of 3 possible versions.

if ($parameter==1) {

@Aa=qw(T T T F F F T);
@Ab=qw(T T F F F F T);
@Ac=qw(T F T F T T T);
@Ad=qw(T F F F T F F);
@Ae=qw(F T T T F F T);
@Af=qw(F T F T F F T);
@Ag=qw(F F T T T F T);
@Ah=qw(F F F T T F T);

$tab1 = DataTable( [
    ["\( p \)","\( q \)", "\( r \)", "\( \text{not } p \)" ,
"\( \text{not } q \)",
"\( p \text{ and } (\text{not }q) \text{ and } r \)","\( (\text{not }p) \text{ or } q \text{ or } r\)"],
	["T", "T", "T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "T", "F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "F", "T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "F", "F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F", "T","T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F","T","F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F","F","T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F","F","F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)]
],
    align           => '|c|c|c|c|c|c|c|',
    horizontalrules => 1
);
}
elsif ($parameter==2) {

@Aa=qw(T T T F F F T);
@Ab=qw(T T F F F F T);
@Ac=qw(T F T F T F T);
@Ad=qw(T F F F T F T);
@Ae=qw(F T T T F F T);
@Af=qw(F T F T F F T);
@Ag=qw(F F T T T T T);
@Ah=qw(F F F T T F F);

$tab1 = DataTable( [
    ["\( p \)","\( q \)", "\( r \)", "\( \text{not } p \)" ,
"\( \text{not } q \)",
"\( (\text{not } p) \text{ and } (\text{not }q) \text{ and } r \)","\( p \text{ or } q \text{ or } r\)"],
	["T", "T", "T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "T", "F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "F", "T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "F", "F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F", "T","T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F","T","F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F","F","T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F","F","F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)]
],
    align           => '|c|c|c|c|c|c|c|',
    horizontalrules => 1
);
}

else {

@Aa=qw(T T T F F F T);
@Ab=qw(T T F F F F T);
@Ac=qw(T F T F T F T);
@Ad=qw(T F F F T F T);
@Ae=qw(F T T T F T T);
@Af=qw(F T F T F F F);
@Ag=qw(F F T T T F T);
@Ah=qw(F F F T T F T);

$tab1 = DataTable( [
    ["\( p \)","\( q \)", "\( r \)", "\( \text{not } p \)" ,
"\( \text{not } q \)",
"\( (\text{not } p) \text{ and } q \text{ and } r \)","\( p \text{ or } (\text{not } q) \text{ or } r\)"],
	["T", "T", "T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "T", "F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "F", "T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "F", "F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F", "T","T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F","T","F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F","F","T",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F","F","F",ans_rule(10),ans_rule(10),ans_rule(10),ans_rule(10)]
],
    align           => '|c|c|c|c|c|c|c|',
    horizontalrules => 1
);
}


BEGIN_PGML
Complete the following truth table by filling in the blanks with T or F as
appropriate.

[$tab1]*

END_PGML

ANS(str_cmp($Aa[3]) );
ANS(str_cmp($Aa[4]) );
ANS(str_cmp($Aa[5]) );
ANS(str_cmp($Aa[6]) );

ANS(str_cmp($Ab[3]) );
ANS(str_cmp($Ab[4]) );
ANS(str_cmp($Ab[5]) );
ANS(str_cmp($Ab[6]) );

ANS(str_cmp($Ac[3]) );
ANS(str_cmp($Ac[4]) );
ANS(str_cmp($Ac[5]) );
ANS(str_cmp($Ac[6]) );

ANS(str_cmp($Ad[3]) );
ANS(str_cmp($Ad[4]) );
ANS(str_cmp($Ad[5]) );
ANS(str_cmp($Ad[6]) );

ANS(str_cmp($Ae[3]) );
ANS(str_cmp($Ae[4]) );
ANS(str_cmp($Ae[5]) );
ANS(str_cmp($Ae[6]) );



ANS(str_cmp($Af[3]) );
ANS(str_cmp($Af[4]) );
ANS(str_cmp($Af[5]) );
ANS(str_cmp($Af[6]) );


ANS(str_cmp($Ag[3]) );
ANS(str_cmp($Ag[4]) );
ANS(str_cmp($Ag[5]) );
ANS(str_cmp($Ag[6]) );

ANS(str_cmp($Ah[3]) );
ANS(str_cmp($Ah[4]) );
ANS(str_cmp($Ah[5]) );
ANS(str_cmp($Ah[6]) );


ENDDOCUMENT();        # This should be the last executable line in the problem.;
