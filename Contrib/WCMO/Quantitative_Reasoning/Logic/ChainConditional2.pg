## DESCRIPTION
## 
## ENDDESCRIPTION

## KEYWORDS('conditional','deductive argument')

## DBsubject('')
## DBchapter('')
## DBsection('')
## Date('')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')

DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserMultipleChoice.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@fprem = ("If deforestation continues at the current rate, then wildlife habitats will be destroyed",
        "If inflation rates rise, then the cost of living will increase.",
        "If water conservation efforts improve, then water scarcity will be reduced.",
        "If public health campaigns are effective, then vaccination rates will increase.",
        "If urban areas are better planned, then access to green spaces will improve.",
        "If renewable energy technology advances, then energy costs will decrease.",
        "If education on financial literacy is expanded, then people will manage their money better.",
        "If community policing initiatives are strengthened, then trust between law enforcement and communities will grow."
        );
@sprem = ("If wildlife habitats are destroyed, then many species will face extinction.",
         "If the cost of living increases, then many families will struggle to afford basic necessities.",
         "If water scarcity is reduced, then agricultural productivity will increase.",
         "If vaccination rates increase, then the spread of preventable diseases will decline.",
         "If access to green spaces improves, then residents' mental and physical health will benefit.",
         "If energy costs decrease, then more businesses will adopt sustainable practices.",
         "If people manage their money better, then personal debt levels will decrease.",
         "If trust between law enforcement and communities grows, then crime rates may decrease."
         );
@con = ("If many species face extinction, then deforestation continues at the current rate.",
       "If many families struggle to afford basic necessities, then inflation rates rise.",
       "If agricultural productivity increases, then water conservation efforts improve.",
       "If the spread of preventable diseases declines, then public health campaigns are effective.",
       "If residents' mental and physical health benefit, then urban areas are better planned.",
       "If more businesses adopt sustainable practices, then renewable energy technology advances.",
       "If personal debt levels decrease, then education on financial literacy is expanded.",
       "If crime rates decrease, then community policing initiatives are strengthened."
       );
       
$length = $#fprem;

$choice = random(0,$length,1);

$ans = DropDown(
                ["Valid", "Invalid"], "Invalid", placeholder => "- Select one of the following -"
                );

BEGIN_PGML
Determine the validity of the following:

    *Premise:* [$fprem[$choice]]

    *Premise:* [$sprem[$choice]]

    *Conclusion:* [$con[$choice]]

The argument is [_]{$ans}
END_PGML

ENDDOCUMENT();
