## DESCRIPTION
## Quantitative Reasoning: Fallacies - identify the premise, conclusion, and type of fallacy (second set of examples)
## ENDDESCRIPTION

## DBsubject('Set theory and logic')
## DBchapter('Propositional logic')
## DBsection('Rules of inference')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('logic','fallacies','premise','conclusion')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@fals = ("Appeal to popularity (majority)",
         "False Cause",
         "Appeal to ignorance",
         "Hasty generalization",
         "Appeal to emotion",
         "Personal attack"
         );
$falslength = $#fals;

@statements = (
    ["Millions of people use TikTok every day, so it must be the most reliable source of news.", "Everyone in my dorm is buying the new energy drink, so it must be good for you."],
    ["Our team won every game after we got a new mascot. The mascot must be the reason we are winning.", "I listened to music while studying and got an A on the exam. Listening to music must make me smarter."],
    ["No one has proven that the new supplement does not work, so it must be effective.", "There is no evidence that the old house is not haunted, so it must be haunted."],
    ["The first two math classes I took were boring, so all math classes must be boring.", "My neighbor's electric car broke down twice last month, so electric cars must be unreliable."],
    ["Imagine how lonely these shelter puppies feel every night. You have to adopt one today!", "If you really cared about your family's future, you would buy this life insurance policy right now!"],
    ["Why should we believe Maria's budget proposal? She cannot even keep her own desk organized.", "Do not listen to Coach Rivera's advice on nutrition; he is out of shape."]
);

@con = (
        ["TikTok is the most reliable source of news.","The new energy drink is good for you."],
        ["The new mascot is the reason the team is winning.","Listening to music makes me smarter."],
        ["The new supplement is effective.","The old house is haunted."],
        ["All math classes are boring.","Electric cars are unreliable."],
        ["You should adopt a puppy today.","You should buy this life insurance policy."],
        ["We should not believe Maria's budget proposal.","We should not listen to Coach Rivera's advice on nutrition."],
       );
@prem = (
        ["Millions of people use TikTok every day.","Everyone in my dorm is buying the new energy drink."],
        ["The team won every game after getting a new mascot.","I listened to music while studying and got an A on the exam."],
        ["No one has proven that the new supplement does not work.","There is no evidence that the old house is not haunted."],
        ["The first two math classes I took were boring.","My neighbor's electric car broke down twice last month."],
        ["Shelter puppies feel lonely every night.","You care about your family's future."],
        ["Maria cannot keep her own desk organized.","Coach Rivera is out of shape."],
       );       

$falchoice = random(0,$falslength,1);
$ver = random(0,1,1);

$probfal = $fals[$falchoice];
$probcon = $con[$falchoice][$ver];
$probprem = $prem[$falchoice][$ver];
$probstate = $statements[$falchoice][$ver];

@dropdown = ();
# a premise and conclusion from another fallacy serve as distractors
$oth = random(0,$falslength,1);
while ($oth == $falchoice) {
$oth = random(0,$falslength,1);
}
$othprem = $prem[$oth][$ver];
$othcon = $con[$oth][$ver];

$dropdown[0] = DropDown( [[$probprem,$probcon,$othprem,$othcon]], $probprem, placeholder => ' - Select one of the following - ');
$dropdown[1] = DropDown( [[$probprem,$probcon,$othprem,$othcon]], $probcon, placeholder => ' - Select one of the following - ');
$dropdown[2] = DropDown( [[@fals]], $probfal, placeholder => ' - Select one of the following - ');
BEGIN_PGML
For the statement below, select the premise(s), conclusion and what type of fallacy it is.

>>``[$probstate]''<<

Premise(s): [_]{$dropdown[0]}

Conclusion: [_]{$dropdown[1]}

Fallacy: [_]{$dropdown[2]}
END_PGML

ENDDOCUMENT();
