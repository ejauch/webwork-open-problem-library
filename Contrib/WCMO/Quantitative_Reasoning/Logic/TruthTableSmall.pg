## DESCRIPTION
## Quantitative Reasoning: Truth table - two propositions with negations, conjunctions, and disjunctions
## ENDDESCRIPTION

## DBsubject('Set theory and logic')
## DBchapter('Propositional logic')
## DBsection('Truth tables')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('logic','truth table','negation','conjunction','disjunction')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

$parameter = random(1,3,1); #paremater for choosing one of three possible versions

if ($parameter==1) {

@Aa=qw(T T F T T);
@Ab=qw(T F F F F);
@Ac=qw(F T T F T);
@Ad=qw(F F T F T);

$tab1 = DataTable( [
    ["\( p \)","\( q \)", "\( \text{not } p \)" ,
"\( p \text{ and } q\)","\( (\text{not }p) \text{ or } q\)"],
		["T", "T",ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "F",ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F", "T",ans_rule(10),ans_rule(10),ans_rule(10)],     
    ["F","F",ans_rule(10),ans_rule(10),ans_rule(10)]
],
    align           => '|c|c|c|c|c|',
    horizontalrules => 1
);
}
elsif ($parameter==2) {

@Aa=qw(T T F F T);
@Ab=qw(T F F F T);
@Ac=qw(F T T T T);
@Ad=qw(F F T F F);

$tab1 = DataTable( [
    ["\( p \)","\( q \)", "\( \text{not } p \)" ,
"\( (\text{not }p) \text{ and } q\)","\( (p \text{ or } q) \)"],
	["T", "T",ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "F",ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F", "T",ans_rule(10),ans_rule(10),ans_rule(10)],     
    ["F","F",ans_rule(10),ans_rule(10),ans_rule(10)]
],
    align           => '|c|c|c|c|c|',
    horizontalrules => 1
);
}

else {

@Aa=qw(T T F F T);
@Ab=qw(T F F F F);
@Ac=qw(F T T T T);
@Ad=qw(F F T F T);

$tab1 = DataTable( [
    ["\( p \)","\( q \)", "\( \text{not } p \)" ,
"\((\text{not } p) \text{ and } q\)","\( (\text{not }p) \text{ or } q\)"],
		["T", "T",ans_rule(10),ans_rule(10),ans_rule(10)],
    ["T", "F",ans_rule(10),ans_rule(10),ans_rule(10)],
    ["F", "T",ans_rule(10),ans_rule(10),ans_rule(10)],     
    ["F","F",ans_rule(10),ans_rule(10),ans_rule(10)]
],
    align           => '|c|c|c|c|c|',
    horizontalrules => 1
);
}


BEGIN_PGML
Complete the following truth table by filling in the blanks with T or F as
appropriate.

[$tab1]*

END_PGML

ANS(str_cmp($Aa[2]) );
ANS(str_cmp($Aa[3]) );
ANS(str_cmp($Aa[4]) );

ANS(str_cmp($Ab[2]) );
ANS(str_cmp($Ab[3]) );
ANS(str_cmp($Ab[4]) );

ANS(str_cmp($Ac[2]) );
ANS(str_cmp($Ac[3]) );
ANS(str_cmp($Ac[4]) );

ANS(str_cmp($Ad[2]) );
ANS(str_cmp($Ad[3]) );
ANS(str_cmp($Ad[4]) );


ENDDOCUMENT();        # This should be the last executable line in the problem.;
