## DESCRIPTION
## Quantitative Reasoning: Matching propositions with their negations
## ENDDESCRIPTION

## DBsubject('Set theory and logic')
## DBchapter('Propositional logic')
## DBsection('Operations on propositions')
## Date('8/23/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('logic','propositions','negation')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "PGgraders.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;


@props = ("Jack is the fastest runner.","Jill does not like to eat brownies.", "The grass is green.", "The sky is blue.","The cake is a lie.","
Juan is the strongest front tackle.", "Lylla is the best dancer.","Dogs are not the best pets.");
@nprops = ("Jack is not the fastest runner.","Jill likes to eat brownies.","The grass is not green.","The sky is not blue.","The cake is not a lie.","Juan is not the strongest front tackle.","Lylla is not the best dancer.", "Dogs are the best pets.");

$proplength = $#props;
$notproplength = $#notprops;

# Create a list of questions and answers.
@q_and_a;

for my $i (0 .. $proplength) {
$q_and_a[$i] = ["$props[$i]","$nprops[$i]"];
}

# Add extra incorrect answers
@extra_a = ("Jack is the slowest runner.", "Lylla is the worst dancer.", "The grass is red.");

# Randomize the questions.
@q_and_a = map { splice(@q_and_a, random(0, $#q_and_a), 1) } 0 .. $#q_and_a;

# Choose a random order to display the answers (including the incorrect answers).
push(@answers, (map { $_->[1] } @q_and_a), @extra_a);
@indices = (0 .. $#answers);
@shuffle = map { splice(@indices, random(0, $#indices), 1) } 0 .. $#indices;

# Create an inverse map back to the original indices.
@inversion[@shuffle] = (0 .. $#shuffle);

# Add an answer that is always last.  It is also incorrect in this case.
#push(@answers, 'None of the above');
#push(@shuffle, scalar(@shuffle));

@answer_dropdowns =
    map { DropDown([ @ALPHABET[ 0 .. $#answers ] ], $inversion[$_]) }
    0 .. $#q_and_a;
    
    # Incremental grader
install_problem_grader(~~&custom_problem_grader_fluid);
$ENV{grader_numright} = [ 2,   4,  6,  8 ];
$ENV{grader_scores}   = [ 0.25, 0.5, 0.75, 1 ];
$ENV{grader_message} =
    'You can earn '
    . '25% partial credit for 2 - 3 correct answers, and '
    . '50% partial credit for 4 - 5 correct answers.'
    . '75% partial credit for 6-7 correct answers';

HEADER_TEXT(MODES(TeX => '', HTML => <<END_STYLE));
<style>
.two-column {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    justify-content: space-evenly;
}
</style>
END_STYLE

BEGIN_PGML
Match the following propositions with their negations.

[@ MODES(TeX => '\\parbox{0.4\\linewidth}{',
    HTML => '<div class="two-column"><div>') @]*
[@ join(
    "\n\n",
    map {
        '[_]{$answer_dropdowns[' . $_ . ']} '
            . '*' . ($_ + 1) . '.* '
            . '[$q_and_a[' . $_ . '][0]]'
    } 0 .. $#q_and_a
) @]**
[@ MODES(TeX => '}\\hfill\\parbox{0.4\\linewidth}{',
    HTML => '</div><div>') @]*
[@ join(
    "\n\n",
    map {
        '*' . $ALPHABET[($_)] . '.* [$answers[$shuffle[' . $_ . ']]]'
    } 0 .. $#answers
) @]**
[@ MODES(TeX => '}', HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
