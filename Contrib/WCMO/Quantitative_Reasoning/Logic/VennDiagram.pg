## DESCRIPTION
## Quantitative Reasoning: Venn diagram - counting with two sets
## ENDDESCRIPTION

## DBsubject('Set theory and logic')
## DBchapter('Operations on sets')
## DBsection('Venn diagrams')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('sets','Venn diagrams','counting')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

$graph_image = createTikZImage();
$graph_image->tikzLibraries("arrows.meta");


$left = random(16,32,4);
$right = random(9,18,4);
$center = random(7,19,2);
$out = random(15,30,5);

$sum = $left + $right + $center + $out;

$fullleft = $left + $center;
$fullright = $right + $center;

@labels = ("college graduates", "under 30", "pet owners", "parents");
@nlabels = ("not college graduates", "30 or older", "not pet owners", "not parents");

$length = $#labels;

$l = random(0,$length,1);

$r = random(0,$length,1);

while ($r == $l) {
$r = random(0,$length,1);
}

$leftlabel = ucfirst($labels[$l]);
$rightlabel = ucfirst($labels[$r]);

@ans = ();

$ans[0] = Compute("$sum");
$ans[1] = Compute($sum - $fullright);
$ans[2] = Compute($right);
$ans[3] = Compute($fullleft);

$graph_image->BEGIN_TIKZ
\tikzset{>={Stealth[scale=3]}}
    \draw[ultra thick,fill=white] (-8,6) rectangle (8,-5);
\draw[ultra thick,fill=white] (-6,4) rectangle (6,-4);
 \begin{scope} [fill opacity = .4]
    \draw[draw = black, ultra thick,fill=blue] (-1.5,0) circle (2.5);
    \draw[draw = black, ultra thick,fill=red] (1.5,0) circle(2.5);
  \end{scope}
    \draw[<-,>=stealth,thick,black] (-3,0.5) -- (-4,2.25);
    \draw[<-,>=stealth,thick,black] (3,0.5) -- (4,2.5);
    \node at (-4,2.5) {\bf $leftlabel};
    \node at (4,2.5) {\bf $rightlabel};
    \node at (-2,0) {\Large $left};
    \node at (2,0) {\Large $right};
    \node at (0,0) {\Large $center};
    \node at (0,-3) {\Large $out};
    \node at (0,5) {\bf People Who Completed};
    \node at (0,4.5) {\bf A Survey};
END_TIKZ


BEGIN_PGML
Use the following Venn diagram to answer the following:

>> [@ image($graph_image, width => 400, tex_size => 600) @]* <<

(a) How many people filled out the survey in total? [____]{$ans[0]}

(b) How many people who filled out the survey are [$nlabels[$r]]? [___]{$ans[1]}

(c) How many people are [$labels[$r]] but are [$nlabels[$l]]? [___]{$ans[2]}

(d) How many people who are [$labels[$l]] filled out the survey? [___]{$ans[3]}

END_PGML


ENDDOCUMENT();
