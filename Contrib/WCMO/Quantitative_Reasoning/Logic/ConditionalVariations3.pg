## DESCRIPTION
## Quantitative Reasoning: Conditional restatements - converse, inverse, and contrapositive (whenever form)
## ENDDESCRIPTION

## DBsubject('Set theory and logic')
## DBchapter('Propositional logic')
## DBsection('Operations on propositions')
## Date('7/11/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('logic','conditional','converse','inverse','contrapositive')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "MathObjects.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

Context()->strings->add(T=>{},F=>{});

$par = random(0,3,1);

@hyp = ("it rains", "you study", "the sun sets", "the temperature drops", "you practice", "a fire burns", "you exercise", "a seed is planted", "a balloon is punctured", "the power goes out", "you overwater plants", "the alarm rings", "ice is heated", "you eat too much", "a button is pressed");
@con = ("the ground will be wet", "you will pass the exam", "the sky will darken", "water will freeze", "you will improve", "smoke will rise", "you will get stronger", "a plant will grow", "it will deflate", "the lights will turn off", "they will wilt", "you will wake up", "it will melt", "you will feel full", "the device will turn on");
@nhyp = ("it does not rain", "you do not study", "the sun does not set", "the temperature does not drop", "you do not practice", "a fire does not burn", "you do not exercise", "a seed is not planted", "a balloon is not punctured", "the power does not go out", "you do not overwater plants", "the alarm does not ring", "ice is not heated", "you do not eat too much", "a button is not pressed");
@ncon = ("the ground will not be wet", "you will not pass the exam", "the sky will not darken", "water will not freeze", "you will not improve", "smoke will not rise", "you will not get stronger", "a plant will not grow", "it will not deflate", "the lights will not turn off", "they will not wilt", "you will not wake up", "it will not melt", "you will not feel full", "the device will not turn on");

$probhyp = $hyp[$par];
$probcon = $con[$par];
$probnhyp = $nhyp[$par];
$probncon = $ncon[$par];

$conv = "If $probcon, then $probhyp.";
$inv = "If $probnhyp, then $probncon.";
$cont = "If $probncon, then $probnhyp.";

$hyppopup = DropDown([["$probhyp", "$probcon"]], "$probhyp", placeholder => "- Select from the following -");
$conpopup = DropDown([["$probhyp", "$probcon"]], "$probcon", placeholder => "- Select from the following -");
$convpopup = DropDown([["$conv", "$inv","$cont"]], "$conv", placeholder => "- Select from the following -");
$invpopup = DropDown([["$conv", "$inv","$cont"]], "$inv", placeholder => "- Select from the following -");
$contpopup = DropDown([["$conv", "$inv","$cont"]], "$cont", placeholder => "- Select from the following -");

$statement = ucfirst("$probcon whenever $probhyp.");

TEXT(beginproblem());
BEGIN_PGML
For each of the following conditionals state the hypothesis, [`p`], and the conclusion, [`q`], and select the converse, inverse, and contrapositive.

>>``[$statement]''<<

Hypothesis: [_]{$hyppopup}

Conclusion: [_]{$conpopup}

Converse: [_]{$convpopup}

Inverse: [_]{$invpopup}

Contrapositive: [_]{$contpopup}

END_PGML

ENDDOCUMENT();
