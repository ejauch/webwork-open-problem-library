## DESCRIPTION
## Quantitative Reasoning: Scientific notation - converting a large number
## ENDDESCRIPTION

## DBsubject('Algebra')
## DBchapter('Algebra of real numbers and simplifying expressions')
## DBsection('Scientific notation')
## Date('11/18/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('scientific notation','powers of ten','large numbers')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextScientificNotation.pl",
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

Context("Numeric");

# A four-digit number (its last digit is always odd, so it never ends in 0)
# times a power of ten, so the answer always has exactly 4 significant digits.
$base = random(3211,4200,22);
$p = random(4,8,1);
$a = $base*10**$p;

# The answer is $m x 10^$n.
$m = $base/1000;
$n = $p + 3;

# The answer must be entered as a number between 1 and 10 with exactly
# 3 digits after the decimal point, times a power of 10.
Context("ScientificNotation");

Context()->flags->set(
    snDigits => 3,
    snTrimZeros => 0,
    snMinDigits => 3,
    snMaxDigits => 3,
);
Context()->flags->set(tolType => 'digits', tolerance => 4, tolTruncation => 1);

$ans = ScientificNotation($a);

# HINTS messages for common wrong answers. Each one checks for a specific
# wrong value, so the answer is still marked wrong.
@snHints = (
    sub { my ($c, $s) = @_; my $w = $m*10**($n-1); abs($s->value - $w) <= 1E-9*$w } =>
        "Your power of 10 is one too small. Count how many places the decimal point moves "
      . "to the left to leave one digit in front of it.",
    sub { my ($c, $s) = @_; my $w = $m*10**($n+1); abs($s->value - $w) <= 1E-9*$w } =>
        "Your power of 10 is one too large. Count how many places the decimal point moves "
      . "to the left to leave one digit in front of it.",
    sub { my ($c, $s) = @_; my $w = $m*10**(-$n); abs($s->value - $w) <= 1E-9*$w } =>
        "The original number is larger than 10, so the power of 10 should be positive, not negative.",
);

BEGIN_PGML
Convert [$a] to scientific notation. (Keep all four significant digits.)

[_]{$ans->cmp->withPostFilter(AnswerHints(@snHints))}{15}
END_PGML


ENDDOCUMENT();
