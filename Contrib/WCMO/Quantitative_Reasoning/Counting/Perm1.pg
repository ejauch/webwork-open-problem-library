## DESCRIPTION
## Quantitative Reasoning: Permutations - ordered relay teams
## ENDDESCRIPTION

## DBsubject('Combinatorics')
## DBchapter('Counting')
## DBsection('Permutations')
## Date('11/2/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('counting','permutations')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextScientificNotation.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

$team = random(8,14,2);

$ans =  P($team,4);

BEGIN_PGML
A coach wants to create a 4-person relay team from a team with [$team] players. How many relay teams are possible?

Answer: [_]{$ans}
END_PGML

ENDDOCUMENT();
