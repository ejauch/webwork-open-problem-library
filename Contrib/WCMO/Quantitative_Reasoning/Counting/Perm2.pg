## DESCRIPTION
## Quantitative Reasoning: Permutations - ranked election outcomes
## ENDDESCRIPTION

## DBsubject('Combinatorics')
## DBchapter('Counting')
## DBsection('Permutations')
## Date('11/2/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('counting','permutations')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextScientificNotation.pl",
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

$cand = random(10,18,1);

$pos = random(3,5,1);

$ans =  P($cand,$pos);

# HINTS messages for common wrong answers.
$ansCmp = Real($ans)->cmp->withPostFilter(AnswerHints(
    Real(C($cand, $pos)) =>
        "That counts groups of $pos candidates where order does not matter. However, in this setting the order "
      . "matters (who runs first, second, etc.), so use permutations.",
    Real($cand**$pos) =>
        "A candidate can only fill one roll, so the choices go down after each position is filled.",
));

BEGIN_PGML
A city has [$cand] candidates running for [$pos] leadership positions, where the top vote-getter gets the first position, the second the second position, etc. How many outcomes are possible in this situation?

Answer: [_]{$ansCmp}
END_PGML

ENDDOCUMENT();
