## DESCRIPTION
## Quantitative Reasoning: Combinations - choosing a subset of items to pack
## ENDDESCRIPTION

## DBsubject('Combinatorics')
## DBchapter('Counting')
## DBsection('Combinations')
## Date('11/2/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('counting','combinations')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextScientificNotation.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0


$total = random(10,25,1);

$num = random(3,5,1);

$ans =  C($total,$num);


BEGIN_PGML
A famous cosplayer has [$total] different cosplays to pick [$num] to take to an upcoming convention. How many possible sets of [$num] can they pack?

Answer: [_]{$ans}
END_PGML

ENDDOCUMENT();
