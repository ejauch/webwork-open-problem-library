## DESCRIPTION
## Quantitative Reasoning: Combinations - choosing a team from a club
## ENDDESCRIPTION

## DBsubject('Combinatorics')
## DBchapter('Counting')
## DBsection('Combinations')
## Date('11/2/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('counting','combinations')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextScientificNotation.pl",
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

$students = random(20,35,1);

$team = random(5,8);

$ans =  C($students,$team);

# HINTS messages for common wrong answers.
$ansCmp = Real($ans)->cmp->withPostFilter(AnswerHints(
    Real(P($students, $team)) =>
        "That is a permutation, which counts the students in the order they are picked. A team is "
      . "the same team no matter what order its members are chosen, so use combinations.",
    Real($students**$team) =>
        "That allows the same student to be picked more than once and counts different orders. "
      . "Each student can only be picked once, and order does not matter, so use combinations.",
    Real(fact($students)/fact($team)) =>
        "Close: in the combination formula you also need to divide by ($students - $team)!, "
      . "not just by $team!.",
));


BEGIN_PGML
A club has [$students] students and they need to create a team of [$team] to represent them at the College Club Competition. How many teams are possible?

Answer: [_]{$ansCmp}
END_PGML

ENDDOCUMENT();
