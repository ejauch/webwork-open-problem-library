## DESCRIPTION
## Quantitative Reasoning: Unit conversion - grams per cubic centimeter to pounds per cubic inch
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','units','density')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$d = random(12,16,1);

$dens = Compute("$d*2.540**3/453.6");




BEGIN_PGML
Convert [$d] grams per cubic centimeter to pounds per cubic inch (rounded to the nearest thousandth).

Answer: [____]{DecimalPlacesCmp($dens, 3)} pounds per cubic inch.

END_PGML


ENDDOCUMENT();
