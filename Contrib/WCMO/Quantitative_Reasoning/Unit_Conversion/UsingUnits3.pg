## DESCRIPTION
## Quantitative Reasoning: Using units - hourly pay rate
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Interpretation')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('units','rates')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@item = ("balls","toys","eggs","plants");

$pitem = $item[random(0,$#item,1)];

$pay = random(320,510,30);

$hours = random(12,28,4);

$rate = $pay/$hours;

$ans = $rate;

BEGIN_PGML

What is your hourly rate if you earn $[$pay] for [$hours] hours of work? (Round to the nearest cent.)

Hourly rate is $ [_]{DecimalPlacesCmp($ans, 2)}.
END_PGML

ENDDOCUMENT();
