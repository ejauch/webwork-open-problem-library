## DESCRIPTION
## Quantitative Reasoning: Unit conversion - meters per second to miles per hour
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','units','speed')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$d = random(11,19,2);
$t = random(2,6,2);

$speed = Compute("$d/$t*0.001*0.6214*3600");




BEGIN_PGML
A certain bird was measured to travel a distance of [$d] meters in [$t] seconds. How fast was it moving in miles per hour (rounded to the nearest hundredth)?

It was moving [____]{DecimalPlacesCmp($speed, 2)} miles per hour.

END_PGML


ENDDOCUMENT();
