## DESCRIPTION
## Quantitative Reasoning: Using units - total cost from a price per pound
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Interpretation')
## Date('9/5/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('units','rates','unit price')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextCurrency.pl",
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@fruit = ("apples", "strawberries", "oranges","pineapples","bananas");

$pfruit = $fruit[random(0,$#fruit,1)];

$price = 1 + random(16,68,4)/100;
$pricedisp = sprintf("%.2f", $price);

$weight = random(12,28,4)/10;

$total = round($price*$weight*100)/100;

$ans = $total;

# HINTS (added from FA24 WeBWorK answers): messages for common wrong answers.
# AnswerHints shows its message even on a correct answer, so any hint that equals the
# correct answer is left out.
@totalHintList = (
    [ int($price*$weight*100)/100,
      "Round to the nearest cent instead of cutting off the extra digits." ],
    [ $price/$weight, "Multiply the price per pound by the number of pounds." ],
    [ $weight/$price, "Multiply the price per pound by the number of pounds." ],
);
$totalCmp = Real($ans)->cmp->withPostFilter(AnswerHints(
    map { (Real($_->[0]) => $_->[1]) } grep { Real($_->[0]) != Real($ans) } @totalHintList
));

BEGIN_PGML

How much would you pay for [$weight] pounds of [$pfruit] if it costs $[$pricedisp] per pound?

Total amount paid is $ [_]{$totalCmp}
END_PGML

ENDDOCUMENT();
