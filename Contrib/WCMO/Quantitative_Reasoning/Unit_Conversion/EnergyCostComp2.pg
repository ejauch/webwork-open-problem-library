## DESCRIPTION
## Quantitative Reasoning: Energy cost comparison - computers
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('units','unit conversion','energy','kilowatt-hour')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  'contextCurrency.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$hours = random(5,10,1);
 
$hwatt = random(1600,1900,100);
$lwatt = $hwatt - random(125,325,50);
$cost = random(22,31,3)/100;


$hcost = Compute("$hwatt*$hours/1000*$cost");
$lcost = Compute("$lwatt*$hours/1000*$cost");

$rhcost = sprintf("%0.2f",$hcost);
$rlcost = sprintf("%0.2f",$lcost);

$costdif = $rhcost - $rlcost;

Context("Currency");

$ans = Currency("$costdif");


BEGIN_PGML
You are looking at two different computers for your dorm. The higher-end system uses [$hwatt] watts of power for [$hours] hours of use and the smaller system uses [$lwatt] watts for the same amount of time. If your energy costs [`\$[$cost]`] a kilowatt-hour, what is the difference in cost over the [$hours] hours?

The difference in cost is [____]{DecimalPlacesCmp($ans, 2)} (Enter the $ with your answer, rounded to the nearest cent.)

END_PGML


ENDDOCUMENT();
