## DESCRIPTION
## Quantitative Reasoning: Temperature conversion - Kelvin to Fahrenheit
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','temperature')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$k = random(150,255,15);

$c = Compute("$k-273.15");

$f = Compute("$c*9/5+32");




BEGIN_PGML
Convert [$k] K to Fahrenheit (rounded to the nearest hundredth).

Answer: [____]{DecimalPlacesCmp($f, 2)}[`{}^\circ`] F

END_PGML


ENDDOCUMENT();
