## DESCRIPTION
## Quantitative Reasoning: Temperature conversion - Celsius to Fahrenheit
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','temperature')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$c = random(75,95,5);

$f = Compute("$c*9/5+32");




BEGIN_PGML
Convert [`[$c]^\circ`]C to Fahrenheit (rounded to the nearest hundredth).

Answer: [____]{DecimalPlacesCmp($f, 2)}[`{}^\circ`] F

END_PGML


ENDDOCUMENT();
