## DESCRIPTION
## Quantitative Reasoning: Temperature conversion - Celsius to Kelvin
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','temperature')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$c = random(-220,120,30);

$k = Compute("$c+273.15");



BEGIN_PGML
Convert [`[$c]{}^\circ`] C to Kelvin (rounded to the nearest hundredth).

Answer: [____]{DecimalPlacesCmp($k, 2)} K

END_PGML


ENDDOCUMENT();
