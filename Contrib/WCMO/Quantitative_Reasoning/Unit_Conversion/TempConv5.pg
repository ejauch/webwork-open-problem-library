## DESCRIPTION
## 
## ENDDESCRIPTION

## KEYWORDS('unit conversion','temperature')

## DBsubject('')
## DBchapter('')
## DBsection('')
## Date('')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$c = random(-220,120,30);

$k = Compute("$c+273.15");

$ans = Compute("$k");


BEGIN_PGML
Convert [`[$c]{}^\circ`] C to Kelvin (rounded to the nearest hundredth).

Answer: [____]{$ans->cmp(
    tolType   => 'absolute',
    tolerance => .0001)} K

END_PGML


ENDDOCUMENT();
