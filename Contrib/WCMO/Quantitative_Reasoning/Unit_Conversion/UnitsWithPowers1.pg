## DESCRIPTION
## Quantitative Reasoning: Units with powers - square yards to square feet
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','units','area')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@fdim = ();
@ydim = ();

foreach my $i (0,1) {
$j=$i+3;
$k=$j+8;
$ydim[$i] = random($j,$k,2);
$fdim[$i] = $ydim*3;
}
$yarea = $ydim[0]*$ydim[1];
$farea = $yarea*9;


$ans = $farea;

BEGIN_PGML
You purchased a rug that is [$yarea] square yards. What area does the rug cover in square feet?

The rug covers [__]{$ans} square feet.
END_PGML

ENDDOCUMENT();
