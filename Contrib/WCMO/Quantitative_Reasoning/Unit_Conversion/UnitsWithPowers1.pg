## DESCRIPTION
## Quantitative Reasoning: Units with powers - square yards to square feet
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','units','area')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@fdim = ();
@ydim = ();

foreach my $i (0,1) {
$j=$i+3;
$k=$j+8;
$ydim[$i] = random($j,$k,2);
$fdim[$i] = $ydim*3;
}
$yarea = $ydim[0]*$ydim[1];
$farea = $yarea*9;


$ans = $farea;

# HINTS (added from FA24 WeBWorK answers): messages for common wrong answers.
$areaCmp = Real($ans)->cmp->withPostFilter(AnswerHints(
    Real($yarea*3) => "A square yard is 3 ft by 3 ft, which is 9 square feet, not 3. "
                    . "Multiply by 9.",
    Real($yarea/3) => "Square feet are smaller than square yards, so the number should get bigger. "
                    . "A square yard is 3 ft by 3 ft, which is 9 square feet.",
    Real($yarea/9) => "Square feet are smaller than square yards, so the number should get bigger. "
                    . "Multiply by 9 instead of dividing.",
    Real($yarea*27) => "27 is the number of cubic feet in a cubic yard. For area, "
                     . "1 square yard = 3 ft by 3 ft = 9 square feet.",
));

BEGIN_PGML
You purchased a rug that is [$yarea] square yards. What area does the rug cover in square feet?

The rug covers [__]{$areaCmp} square feet.
END_PGML

ENDDOCUMENT();
