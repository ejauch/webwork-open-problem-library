## DESCRIPTION
## Quantitative Reasoning: Temperature conversion - Kelvin to Celsius
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','temperature')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$k = random(150,255,15);

$c = Compute("$k-273.15");

$f = Compute("$c*9/5+32");




# HINTS (added from FA24 WeBWorK answers): messages for common wrong answers.
$cHints = [
    [ $k - 273,
      "Use 273.15, not 273, when converting Kelvin to Celsius." ],
    [ -$c,
      "Check your sign. C = K - 273.15, so a temperature below 273.15 K is negative in Celsius." ],
    [ $k + 273.15,
      "To go from Kelvin to Celsius, subtract 273.15." ],
    [ $f,
      "That is the temperature in Fahrenheit. The question asks for Celsius: C = K - 273.15." ],
];

BEGIN_PGML
Convert [$k] K to Celsius (rounded to the nearest hundredth).

Answer: [____]{DecimalPlacesCmp($c, 2, hints => $cHints)}[`{}^\circ`] C

END_PGML


ENDDOCUMENT();
