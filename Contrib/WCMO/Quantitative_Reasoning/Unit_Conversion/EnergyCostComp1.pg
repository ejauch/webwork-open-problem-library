## DESCRIPTION
## Quantitative Reasoning: Energy cost comparison - light bulbs
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('units','unit conversion','energy','kilowatt-hour')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  'contextCurrency.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;


Context("Numeric");

$bulbs = random(3,5,1);

$days = random(5,10,1);
 
$hwatt = random(60,80,5);
$lwatt = random(10,15,1);
$cost = random(22,31,3)/100;


$hcost = Compute("$bulbs*$hwatt*$days*24/1000*$cost");
$lcost = Compute("$bulbs*$lwatt*$days*24/1000*$cost");

$costdif = $hcost - $lcost;

Context("Currency");

$ans = Currency("$costdif");


BEGIN_PGML
What is the difference in cost to power a [$bulbs]-bulb lamp with [$hwatt]-watt bulbs vs [$lwatt]-watt bulbs for [$days] days if your energy costs [`\$[$cost]`] a kilowatt-hour?

The difference in cost is [____]{DecimalPlacesCmp($ans, 2)} (Enter the $ with your answer, rounded to the nearest cent.)

END_PGML


ENDDOCUMENT();
