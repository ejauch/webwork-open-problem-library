## DESCRIPTION
## Quantitative Reasoning: Temperature conversion - Fahrenheit to Kelvin
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','temperature')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$f = random(-40,-14,2);

$c = Compute("($f-32)*5/9");


$k = $c + 273.15;



BEGIN_PGML
Convert [`[$f]^\circ`]F to Kelvin (rounded to the nearest hundredth).

Answer: [____]{DecimalPlacesCmp($k, 2)} K

END_PGML


ENDDOCUMENT();
