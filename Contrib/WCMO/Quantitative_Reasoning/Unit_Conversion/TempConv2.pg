## DESCRIPTION
## Quantitative Reasoning: Truth Table - Three propositions with negations and conjunctions
## ENDDESCRIPTION

## DBsubject()
## DBchapter()
## DBsection(Unit Conversions)
## Author: Erich Jauch
## Institution(WCMO)
## KEYWORDS('unit conversion', 'units')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$f = random(-40,-14,2);

$c = Compute("($f-32)*5/9");

$rc = sprintf("%0.2f",$c);

$k = Compute("$rc+273.15");

$ans = Compute("$k");


BEGIN_PGML
Convert [`[$f]^\circ`]F to Kelvin (rounded to the nearest hundredth).

Answer: [____]{$ans->cmp(
    tolType   => 'absolute',
    tolerance => .0001)} K

END_PGML


ENDDOCUMENT();
