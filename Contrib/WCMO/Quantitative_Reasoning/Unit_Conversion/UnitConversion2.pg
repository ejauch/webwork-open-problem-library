## DESCRIPTION
## Quantitative Reasoning: Unit conversion - cubic inches to cubic meters
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Units')
## DBsection('Conversions')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('unit conversion','units','volume')


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "decimalPlaces.pl",
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$w = random(16,32,4);
$d = random(8,12,2);
$h = random(10,18,1);

$vol = Compute("$w*$d*$h*2.540**3*0.01**3");




BEGIN_PGML
If a rectangular fish tank that is [$w] in wide, [$d] in deep, and [$h] in tall is filled to the brim with water, how many cubic meters of water would be in the tank (rounded to the nearest thousandth)?

The tank contains [____]{DecimalPlacesCmp($vol, 3)} cubic meters of water.

END_PGML


ENDDOCUMENT();
