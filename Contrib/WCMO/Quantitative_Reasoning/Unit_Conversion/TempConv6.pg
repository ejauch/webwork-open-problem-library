## DESCRIPTION
## 
## ENDDESCRIPTION

## KEYWORDS('unit conversion','temperature')

## DBsubject('')
## DBchapter('')
## DBsection('')
## Date('')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  'PGML.pl',
  'niceTables.pl',
  'PGtikz.pl',
  "PGcourse.pl"
);


$showPartialCorrectAnswers = 1;

Context("Numeric");

$c = random(-220,120,30);

$f = Compute("9/5*$c+32");

$ans = Compute("$c");


BEGIN_PGML
Convert [`[$f]{}^\circ`] F to Celsius.

Answer: [____]{$ans->cmp(
    tolType   => 'absolute',
    tolerance => .0001)}[`{}^\circ`] C

END_PGML


ENDDOCUMENT();
