## DESCRIPTION
## Quantitative Reasoning: Percent of a percent - relative decrease
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Percents')
## DBsection('Applications')
## Date('9/26/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('percentages','relative change','percent decrease')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextCurrency.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;


$per = random(31,41,2);

$pdec = random(11,15,1);

$pof = (100-$pdec);

$ans = $per*$pof/100;

# Common wrong answers, for hint messages
$ppError    = $per - $pdec;            # subtracted percentage points
$changeOnly = $per*$pdec/100;          # found the decrease but did not subtract it
$increased  = $per*(100 + $pdec)/100;  # increased instead of decreased

$pctHints = [
    [ $ppError,    "It looks like you subtracted $pdec percentage points. "
                 . "A decrease of $pdec% of its 2018 value means the decrease is $pdec% OF $per%, "
                 . "not $pdec percentage points." ],
    [ $changeOnly, "That is the size of the decrease ($pdec% of $per%). "
                 . "What is left after you take it away from the 2018 value?" ],
    [ $increased,  "It looks like you increased the 2018 value. The number decreased." ],
];


BEGIN_PGML
In 2018, [$per]% of students at a college were involved in athletics. In 2020, that
number decreased by [$pdec]% of its 2018 value. What percentage of students were involved in athletics in
2020? (Round to the nearest whole percent.)

[_]{DecimalPlacesCmp($ans, 0, hints => $pctHints, hintTolerance => 0)}%
END_PGML


ENDDOCUMENT();
