## DESCRIPTION
## Quantitative Reasoning: Percent of a percent - relative decrease
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Percents')
## DBsection('Applications')
## Date('9/26/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('percentages','relative change','percent decrease')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextCurrency.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;


$per = random(31,41,2);

$pdec = random(11,15,1);

$pof = (100-$pdec);

$ans = $per*$pof/100;


BEGIN_PGML
In 2018, [$per]% of students at a college were involved in athletics. In 2020, that
number decreased by [$pdec]% of its 2018 value. What percentage of students were involved in athletics in
2020? (Round to the nearest whole percent.)

[_]{DecimalPlacesCmp($ans, 0)}%
END_PGML


ENDDOCUMENT();
