## DESCRIPTION
## Quantitative Reasoning: Percent increase - new salary after a raise
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Percents')
## DBsection('Applications')
## Date('9/26/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('percentages','percent increase')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextCurrency.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;


Context("Currency");

$lead = random(14,19,1);

$salary = Currency($lead*1000);

$per = random(310,410,20);

$pre = Currency($salary*(100+$per)/100);


BEGIN_PGML
Imagine you work a part-time job during college making a yearly salary of
[$salary]. After graduating college, you land a job whose salary is [$per]% more than your old one. Your new salary is [_]{DecimalPlacesCmp($pre, 2)}{5} (in dollars and cents).
END_PGML


ENDDOCUMENT();
