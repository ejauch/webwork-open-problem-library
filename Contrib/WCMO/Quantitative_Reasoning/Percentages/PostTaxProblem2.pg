DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextCurrency.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

Context("Currency");

$pre = Currency(random(925,1400,25));
$tax = random(7,13,2);

$post = Currency($pre*(100+$tax)/100);


BEGIN_PGML
You find a brand new laptop that costs [$pre] and the local sales tax is [$tax]%. When the clerk rings up the pruchase at the register, your total (after-tax cost) is [_]{$post}{5}?
END_PGML


ENDDOCUMENT();
