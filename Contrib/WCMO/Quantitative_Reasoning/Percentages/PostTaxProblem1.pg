## DESCRIPTION
## Quantitative Reasoning: Sales tax - after-tax cost of a purchase
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Percents')
## DBsection('Applications')
## Date('9/26/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('percentages','sales tax')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextCurrency.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

Context("Currency");

$pre = Currency(random(12,42,3));
$tax = random(7,13,2);

$post = Currency($pre*(100+$tax)/100);


BEGIN_PGML
If the pre-tax total for your purchase is [$pre] and the local sales tax is [$tax]%, what is the after-tax cost of your purchase?

After tax cost is [_]{DecimalPlacesCmp($post, 2)}{5} (rounded to the nearest cent)
END_PGML


ENDDOCUMENT();
