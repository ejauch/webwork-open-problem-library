## DESCRIPTION
## Quantitative Reasoning: Percent more than - converting to times as large
## ENDDESCRIPTION

## DBsubject('Arithmetic')
## DBchapter('Percents')
## DBsection('Applications')
## Date('9/24/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('percentages','percent more than','relative change')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextCurrency.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@names = ("Liam", "Sofia", "Akira", "Amara", "Sven", "Aisha", "Nikolai", "Leila", "Diego", "Mina", "Ravi", "Ines", "Yusuf", "Mei", "Omar", "Renée", "Dimitri", "Isla", "Mateo", "Hana", "Zane", "Saskia", "Ibrahim", "Talia", "Luciano", "Alina", "Kai", "Anastasia", "Levi", "Fatima");

$len = $#names;

@par = ();

$par[0] = random(0,$len,1);
$par[1] = random(0,$len,1);

while ($par[1]==$par[0]) {
$par[1] = random(0,$len,1);
}

@name = ();
foreach my $i (0,1) {
$name[$i] = $names[$par[$i]];
}

$perm = random(80,300,10);

$pero = $perm + 100;

$times = $pero/100;

# HINTS messages for common wrong answers.
$timesHints = [
    [ $perm/100,
      "That only counts the extra $perm%. Having $perm% more means having the original 100% "
    . "plus another $perm%." ],
    [ $pero,
      "That is a percent. Write it as a number of times by dividing by 100." ],
    [ $perm,
      "That is the percent more, not the number of times as large. Having $perm% more means "
    . "having 100% + $perm% of the other collection; write that percent as a number of times." ],
];

BEGIN_PGML
If [$name[0]] has [$perm]% more collectible figures than [$name[1]], then [$name[0]]'s collection is [__]{DecimalPlacesCmp($times, 1, hints => $timesHints, hintTolerance => 0)} times as large as [$name[1]]'s collection.

(Give your answer rounded to the nearest tenth)

END_PGML


ENDDOCUMENT();
