# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

$mean = random(120,180,5);
$stddev = random(10,25,5);

$bottom = $mean - 3 * $stddev;
$lower = $mean - 1 * $stddev;
$top = $mean + 3 * $stddev;
$upper = $mean + 1 * $stdev;

@vals = ();
@z = ();

foreach my $i (0...2) {
$vals[$i] = sprintf("%0.0f",random($bottom,$top,5));
while ($vals[$i] == $mean) {
$vals[$i] = sprintf("%0.0f",random($bottom,$top,5));
}
}

while ($vals[1] == $vals[0]) {
$vals[1] = sprintf("%0.0f",random($bottom,$top,5));
while ($vals[$i] == $mean) {
$vals[1] = sprintf("%0.0f",random($bottom,$top,5));
}
}
while ($vals[2] == $vals[0] || $vals[2] == $vals[1]) {
$vals[2] = sprintf("%.0f",random($bottom,$top,5));
while ($vals[$i] == $mean) {
$vals[2] = sprintf("%.0f",random($bottom,$top,5));
}
}



foreach my $i (0...2) {
$z[$i] = sprintf("%.2f",($vals[$i]-$mean)/$stddev);
}

@zend = ();

foreach my $i (0...2) {
if ($z[$i] > -1 && $z[$i] < 1) {
if ($z[$i]*100 % 5 == 0) {
$zend[$i] = $z[$i];
}
elsif ($z[$i] < 0) {
$zend[$i] = sprintf("%.2f", (int(-1*$z[$i] / 0.05 + 0.5) * -0.05));
}
else {
$zend[$i] = sprintf("%.2f", (int($z[$i] / 0.05 + 0.5) * 0.05));
}
}
else {
$zend[$i] = sprintf("%0.1f",$z[$i]);
}
}

