foreach my $i (0..2) {
$j = 0;
while ($test[$i] == 0 && $j < $ptablelen) {
if ($zend[$i] == $ztable[$j]) {
$per[$i] = 100 - $pertable[$j];
$test[$i] = 1;
}
else {
$j++;
}
}
}


