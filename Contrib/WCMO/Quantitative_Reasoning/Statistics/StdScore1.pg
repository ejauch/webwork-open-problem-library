## DESCRIPTION
## Quantitative Reasoning: Standard scores - home prices
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Continuous distributions')
## DBsection('Application of a normal distribution')
## Date('10/26/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('statistics','standard score','z-score','normal distribution')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextCurrency.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

$mean = random(225,515,15)*1000;
$stddev = random(2.5,3.5,0.1)*1000;

$bottom = $mean - 3 * $stddev;
$top = $mean + 3 * $stddev;

@vals = ();
@z = ();

foreach my $i (0...4) {
$vals[$i] = random($bottom,$top,2000);
}


while ($vals[1] == $vals[0]) {
$vals[1] = random($bottom,$top,2000);
}

while ($vals[2] == $vals[0] || $vals[2] == $vals[1]) {
$vals[2] = random($bottom,$top,2000);
}

while ($vals[3] == $vals[0] || $vals[3] == $vals[1] || $vals[3] == $vals[2]) {
$vals[3] = random($bottom,$top,2000);
}

while ($vals[4] == $vals[0] || $vals[4] == $vals[1] || $vals[4] == $vals[2] || $vals[4] == $vals[3]) {
$vals[4] = random($bottom,$top,2000);
}

foreach my $i (0...4) {
$z[$i] = ($vals[$i]-$mean)/$stddev;
}


Context("Currency");
$meanprice = Currency($mean);
$stddevprice = Currency($stddev);
@valprice = ();

foreach my $i (0...4) {
$valprice[$i] = Currency($vals[$i]);
}

BEGIN_PGML
The sale prices of homes in a particular neighborhood are normally distributed with a mean price of [$meanprice] with a standard deviation of [$stddevprice]. Find the standard scores associated with the following prices (rounded to 2 decimal places).

- The standard score for [$valprice[0]] is [`z=`][_]{DecimalPlacesCmp($z[0], 2)} ;
- The standard score for [$valprice[1]] is [`z=`][_]{DecimalPlacesCmp($z[1], 2)} ;
- The standard score for [$valprice[2]] is [`z=`][_]{DecimalPlacesCmp($z[2], 2)} ;
- The standard score for [$valprice[3]] is [`z=`][_]{DecimalPlacesCmp($z[3], 2)} ;
- The standard score for [$valprice[4]] is [`z=`][_]{DecimalPlacesCmp($z[4], 2)}.


END_PGML

ENDDOCUMENT();
