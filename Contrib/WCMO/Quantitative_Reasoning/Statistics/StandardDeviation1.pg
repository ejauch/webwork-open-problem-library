## DESCRIPTION
## Quantitative Reasoning: Mean and standard deviation of a small data set
## ENDDESCRIPTION

## DBsubject('Statistics')
## DBchapter('Exploratory data analysis/descriptive statistics')
## DBsection('Summary statistics')
## Date('10/20/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('statistics','mean','standard deviation')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "niceTables.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

my $i = 0;

$nval = random(8,12,1); # number of values in data set less 1.

$val[0] = random(2,4,1);

while ($i<$nval) {

$j = $i + 1;

$val[$j]=$val[$i] + random(0,3,1);

$i++;
}

$sum = 0;
my $k = 0;

while ($k<$nval + 1) {
$sum = $sum + $val[$k];

$k++;
}

$mean = $sum/($nval+1);

@dev = ();
@devsq = ();

foreach $r (0 .. $nval) {
$dev[$r] = $val[$r] - $mean;
$devsq[$r] = $dev[$r]**2;
}

$devsum = 0;
my $s = 0;

while($s < $nval+1) {
$devsum = $devsum + $devsq[$s];
$s++;
}

$std = sqrt($devsum/$nval);

# Common wrong answers, for hint messages (n = $nval + 1 values)
$popStd = sqrt($devsum/($nval + 1));   # divided by n instead of n - 1
$var    = $devsum/$nval;               # forgot the square root
$popVar = $devsum/($nval + 1);         # both

$sdHints = [
    [ $popStd, "It looks like you divided by the number of data values (n). "
             . "For the standard deviation, divide the sum of the squared deviations by n - 1, "
             . "then take the square root." ],
    [ $var,    "It looks like you found the variance. Remember to take the square root as the last step." ],
    [ $popVar, "It looks like you divided by n and did not take the square root. "
             . "Divide the sum of the squared deviations by n - 1, then take the square root." ],
];

$display_string = join(' | ',@val);

$total = $nval + 1;

@colors = ("red","green","blue","yellow");

$color = $colors[random(0,$#colors,1)];

BEGIN_PGML

A collection of [$total] kids all have packages of jelly beans and they have the following counts of [$color] jelly beans:

>>| [$display_string] |<<

The mean of this set is [_]{DecimalPlacesCmp($mean, 1)} (rounded to 1 decimal place)

The standard deviation of this set is [_]{DecimalPlacesCmp($std, 2, hints => $sdHints)} (rounded to two decimal places)

END_PGML


ENDDOCUMENT();
