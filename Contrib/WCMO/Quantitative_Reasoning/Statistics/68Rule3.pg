## DESCRIPTION
## Quantitative Reasoning: 68-95-99.7 rule - expected number above or below a price
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Continuous distributions')
## DBsection('Application of a normal distribution')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('statistics','normal distribution','68-95-99.7 rule')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "contextCurrency.pl",
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

Context("Currency");

$mean = Currency(random(200,300,5)*100);
$stddev = Currency(random(2000,5000,500));

$steps = random(1,3,1);

$par = random(0,1,1);
$sample = random(10,20,2)*1000;

if ($par == 0) {
$value = $mean + $steps*$stddev;
$text = "above";
}
else {
$value = $mean - $steps*$stddev;
$text = "below";
}

if ($steps == 1) {
$ans = 16/100*$sample;
}
elsif ($steps == 2) {
$ans = 2.5/100*$sample;
}
else {
$ans = 0.15/100*$sample;
}

$course = $sub[random(0,$#sub,1)];

# HINTS (added from FA24 WeBWorK answers): messages for common wrong answers.
%precise = (1 => 15.87, 2 => 2.28, 3 => 0.13);
%tail    = (1 => 16, 2 => 2.5, 3 => 0.15);
$ansCmp = Real($ans)->cmp->withPostFilter(AnswerHints(
    Real($precise{$steps}/100*$sample) =>
        "That uses a more precise percentage, like one from a z-table. For this problem, use the "
      . "68-95-99.7 rule to find the percentage, then multiply by the number of cars.",
    [ map { Real($tail{$steps}/100*$sample*$_) } (10, 0.1, 0.01) ] =>
        "Check how you changed the percentage to a decimal. To use $tail{$steps}% in a calculation, "
      . "divide it by 100.",
    Real($tail{$steps}) =>
        "That is the percentage. The question asks how many cars, so multiply that percentage by "
      . "the total number of cars.",
));

BEGIN_PGML
A car dealership finds that the prices for a particular model of car are normally distributed with a mean price of [$mean] and a standard deviation of [$stddev]. If they sold [$sample] cars last year, how many would you expect they sold [$text] a price of [$value]? 

The answer is [_]{$ansCmp}{5} cars.
END_PGML

ENDDOCUMENT();
