## DESCRIPTION
## Quantitative Reasoning: Five-number summary - even number of values
## ENDDESCRIPTION

## DBsubject('Statistics')
## DBchapter('Exploratory data analysis/descriptive statistics')
## DBsection('Summary statistics')
## Date('10/20/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('statistics','five-number summary','quartiles','median')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "niceTables.pl",
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

my $i = 0;

$nval = random(9,15,2); # number of values in data set less 1.

$val[0] = random(3.1,3.9,0.1);

while ($i<$nval) {

$j = $i + 1;

$val[$j]=$val[$i] + random(0.3,1.3,0.4);

$i++;
}

if ($nval % 2 == 0) {
$index = $nval/2;
$median = $val[$index];
if ($index % 2 == 0) {
$lqindexr = $index/2;
$lqindexl = $index/2-1;
$lq = ($val[$lqindexl]+$val[$lqindexr])/2;
$uqindexr = $nval-$lqindexl;
$uqindexl = $uqindexr-1;
$uq = ($val[$uqindexl]+$val[$uqindexr])/2;
}
else {
$lqindex = ($index-1)/2;
$lq = $val[$lqindex];
$uqindex = $nval-$lqindex;
$uq = $val[$uqindex];
}
}
else {
$indexl = ($nval-1)/2;
$indexr = ($nval+1)/2;
$median = ($val[$indexl]+$val[$indexr])/2;
if ($indexl % 2 == 0) {
$lqindex = $indexl/2;
$lq = $val[$lqindex];
$uqindex = $nval-$lqindex;
$uq = $val[$uqindex];
}
else {
$lqindexl = ($indexl-1)/2;
$lqindexr = ($indexl+1)/2;
$lq = ($val[$lqindexl]+$val[$lqindexr])/2;
$uqindexr = $nval-$lqindexl;
$uqindexl = $uqindexr-1;
$uq = ($val[$uqindexl]+$val[$uqindexr])/2;
}
}


$min = $val[0];
$max = $val[$nval];

$display_string = join(' | ',@val);



# HINTS (added from FA24 WeBWorK answers): messages for common wrong answers.
# Quartiles found other ways, for the hints. The data are already sorted.
sub _hintMedian {
    my @a = @_;
    my $m = scalar(@a);
    return $m % 2 ? $a[($m - 1)/2] : ($a[$m/2 - 1] + $a[$m/2])/2;
}
sub _hintQuartileExc {    # spreadsheet QUARTILE.EXC: position (n + 1)p
    my ($p, @a) = @_;
    my $h = (scalar(@a) + 1)*$p - 1;
    my $l = int($h);
    return $a[$l] + ($h - $l)*($a[$l + 1] - $a[$l]);
}
$excMsg = "That matches a spreadsheet QUARTILE function, which uses a different method. Split the "
        . "sorted data into a lower half and an upper half, and find the median of each half.";

$lqHints = [ [ _hintQuartileExc(0.25, @val), $excMsg ] ];
$uqHints = [ [ _hintQuartileExc(0.75, @val), $excMsg ] ];

BEGIN_PGML

Find the five-number summary for the values below.

>>| [$display_string] |<<

Five-number summary: [_]{DecimalPlacesCmp($min, 1)}, [_]{DecimalPlacesCmp($lq, 1, hints => $lqHints, hintTolerance => 0)}, [_]{DecimalPlacesCmp($median, 1)},[_]{DecimalPlacesCmp($uq, 1, hints => $uqHints, hintTolerance => 0)},[_]{DecimalPlacesCmp($max, 1)}

Round all answers to 1 decimal place.
END_PGML


ENDDOCUMENT();
