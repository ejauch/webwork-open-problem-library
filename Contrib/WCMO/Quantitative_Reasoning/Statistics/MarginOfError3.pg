## DESCRIPTION
## Quantitative Reasoning: Margin of error - deciding whether a candidate is sure to lose
## ENDDESCRIPTION

## DBsubject('Statistics')
## DBchapter('Confidence intervals')
## DBsection('One sample proportion')
## Date('10/6/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('statistics','margin of error','confidence interval','polls')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "parserPopUp.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@names = ("Johnson", "Martinez", "Brown", "Patel", "Smith", "Garcia", "Williams", "Lee", "Wilson", "Davis", "Nguyen", "Robinson", "Clark", "Walker", "Hernandez");

$name = $names[random(0,$#names,1)];

$per = random(45,47,1);
$err = random(51,53,1) - $per;

$CIb = $per - $err;
$CIt = $per + $err;

$win = DropDown(['Yes','No'],'No', placeholder => '- Select one of the following -');

BEGIN_PGML
A survey of voters finds that [$per]% of voters plan to vote for candidate [$name], which is less than the majority needed to win. The margin of error in the survey is [$err] percentage points.

The confidence interval for this situation is [_]{$CIb}% to [_]{$CIt}%.

Can we guarantee they will lose? [_]{$win}
END_PGML

ENDDOCUMENT();
