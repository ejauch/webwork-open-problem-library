## DESCRIPTION
## Quantitative Reasoning: Mean, median, and mode - candy collected (even number of values)
## ENDDESCRIPTION

## DBsubject('Statistics')
## DBchapter('Exploratory data analysis/descriptive statistics')
## DBsection('Summary statistics')
## Date('10/20/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('statistics','mean','median','mode')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "decimalPlaces.pl",
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

@amount = ();

my $i = 0;

$nval = random(9,13,2); # number of values in data set less 1.

$amount[0] = random(2,6,1);

while ($i<$nval) {

$j = $i + 1;

$amount[$j]=$amount[$i] + random(3,7,1);

$i++;
}

$modeexist = random(0,1,1);

if ($modeexist == 1) {

$r = $nval - random(1,3,1);

$amount[$r] = random($amount[$r],$amount[$nval],1);

my $s = $r;

while ($s < $nval + 1) {

$amount[$s] = $amount[$r];

$s++;
}
$mode = $amount[$r];
}
else {
$mode = "None";
}

$sum = 0;

foreach $k (0..$nval) {

$sum = $sum + $amount[$k];

}

$mean = $sum/($nval+1);

if ($nval % 2 == 0) {
$index = $nval/2;
$median = $amount[$index];
}
else {
$indexl = ($nval-1)/2;
$indexr = ($nval+1)/2;
$median = ($amount[$indexl]+$amount[$indexr])/2;
}

@shuffled_amount = @amount;

for (my $i = @shuffled_amount - 1; $i > 0; $i--) {
    my $j = random(0,$i,1);  # Pick a random index between 0 and $i
    # Swap elements at index $i and $j
    my $temp = $shuffled_amount[$i];
    $shuffled_amount[$i] = $shuffled_amount[$j];
    $shuffled_amount[$j] = $temp;
}

$display_string = join(' ', @shuffled_amount);

$kidnum = $nval + 1;

# HINTS (added from FA24 WeBWorK answers): messages for common wrong answers.
# middle of the list as shown (not sorted)
$nShown = scalar(@shuffled_amount);
$unsortedMiddle = $nShown % 2
    ? $shuffled_amount[($nShown - 1)/2]
    : ($shuffled_amount[$nShown/2 - 1] + $shuffled_amount[$nShown/2])/2;
$midrange = ($amount[0] + $amount[$nval])/2;
$meanHints = [
    [ $midrange,
      "That is the midrange (halfway between the smallest and largest values). The mean is the "
    . "sum of all of the values divided by how many values there are." ],
    [ $median,
      "That is the median. The mean is the sum of all of the values divided by how many values there are." ],
];
# AnswerHints shows a message even on a correct answer, so leave out any hint whose
# value equals the median.
@medianHintList = (
    [ $mean, "That is the mean. The median is the middle value after the values are sorted "
                 . "from smallest to largest." ],
    [ $unsortedMiddle, "Sort the values from smallest to largest first, then find the middle value." ],
    [ $midrange, "That is the midrange (halfway between the smallest and largest values). "
                     . "The median is the middle value after the values are sorted." ],
);
$medianCmp = Real($median)->cmp->withPostFilter(AnswerHints(
    map { (Real($_->[0]) => $_->[1]) } grep { Real($_->[0]) != Real($median) } @medianHintList
));

BEGIN_PGML

A group of [$kidnum] children collected the following amounts of candy during the fall festivities:

>>[$display_string]<<

Find the following values associated to the data above:

- Mean: [_]{DecimalPlacesCmp($mean, 1, hints => $meanHints)}
- Median: [_]{$medianCmp}
- Mode: [_]{$mode}

If a value does not exist enter *None* in the blank. Round any answers to 1 decimal place.
END_PGML


ENDDOCUMENT();
