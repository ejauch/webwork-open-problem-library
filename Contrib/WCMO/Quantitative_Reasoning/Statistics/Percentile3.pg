## DESCRIPTION
## Quantitative Reasoning: Percentiles of a normal distribution - score for a given percentile
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Continuous distributions')
## DBsection('Application of a normal distribution')
## Date('10/26/24')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('statistics','normal distribution','percentile','standard score')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "decimalPlaces.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0

$mean = random(1000,1200,50);
$stddev = random(50,100,10);

@ztable = (-1.3,-1.2,-1.1,-1,-0.95,-0.9,-0.85,-0.8,-0.75,-0.7,-0.65,-0.6,-0.55,-0.5,-0.45,-0.4,-0.35,-0.3,-0.25,-0.2,-0.15,-0.1,-0.05,0.05,0.1,0.15,0.2,0.25,0.3,0.35,0.4,0.45,0.5,0.55,0.6,0.65,0.7,0.75,0.8,0.85,0.9,0.95,1,1.1,1.2,1.3);

@pertable = (10,12,14,16,17,18,20,21,23,24,26,27,29,31,33,34,36,38,40,42,44,46,48,52,54,56,58,60,62,64,66,67,69,71,73,74,76,77,79,80,82,83,84,86,88,90);

$ptablelen = $#ztable+1;

@choice = (random(0,$#ztable,1),random(0,$#ztable,1));

while ($choice[0] == $choice[1]) {
$choice[1] = random(0,$#ztable,1);
}

@per = ();
@z = ();
@val = ();

foreach my $i (0..1) {
$per[$i] = $pertable[$choice[$i]];
$z[$i] = $ztable[$choice[$i]];
$val[$i] = $z[$i]*$stddev + $mean;
}


BEGIN_PGML
If the mean score on the SAT was [$mean] with a standard deviation of [$stddev], find the test scores that would correspond to the following percentiles:

- [$per[0]]% of tests had a score at or below [_]{DecimalPlacesCmp($val[0], 0)} (rounded to the nearest whole number);
- [$per[1]]% of tests had a score at or below [_]{DecimalPlacesCmp($val[1], 0)} (rounded to the nearest whole number).

END_PGML

BEGIN_PGML_HINT
Use the standard score table in Section 6C of _Using and Understanding Mathematics: A Quantitative Reasoning Approach_ (7th ed.).
END_PGML_HINT

ENDDOCUMENT();
