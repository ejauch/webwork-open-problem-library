## DESCRIPTION
## Quantitative Reasoning: 68-95-99.7 rule - percentage of data outside a range
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Continuous distributions')
## DBsection('Application of a normal distribution')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('statistics','normal distribution','68-95-99.7 rule')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$mean = random(651,751,16)/10;
$stddev = random(31,71,8)/10;

$steps = random(1,3,1);

$bottom = $mean - $steps*$stddev;
$top = $mean + $steps*$stddev;

if ($steps == 1) {
$ans = 32;
}
elsif ($steps == 2) {
$ans = 5;
}
else {
$ans = 0.3;
}

BEGIN_PGML
A manufacturer that makes packages of cookies has a normal distribution of the weights of the packages of cookies with a mean weight of [$mean] grams and a standard deviation of [$stddev] grams. What percentage of package weights fall outside the range from [$bottom] grams to [$top] grams?

The answer is [_]{$ans}{5} %
END_PGML

ENDDOCUMENT();
