## DESCRIPTION
## Quantitative Reasoning: 68-95-99.7 rule - percentage of data within a range
## ENDDESCRIPTION

## DBsubject('Probability')
## DBchapter('Continuous distributions')
## DBsection('Application of a normal distribution')
## Date('10/28/26')
## Author('Erich Jauch')
## Institution('Westminster College (Missouri)')
## KEYWORDS('statistics','normal distribution','68-95-99.7 rule')


DOCUMENT();

loadMacros(
    "PGstandard.pl",    # Standard macros for PG language
    "PGML.pl",          # PGML markup and Math Objects
    "answerHints.pl",
    "PGcourse.pl",      # Customization file for the course
);

# Uncomment the following if you don't want to show which
# answers are correct and which are incorrect
#$showPartialCorrectAnswers = 0;

$mean = random(65,75,1);
$stddev = random(3,7,1);

$steps = random(1,3,1);

$bottom = $mean - $steps*$stddev;
$top = $mean + $steps*$stddev;

if ($steps == 1) {
$ans = 68;
}
elsif ($steps == 2) {
$ans = 95;
}
else {
$ans = 99.7;
}

@sub = ("Mathematics", "Physics", "Chemistry", "Biology", "Computer Science", "Economics", "Psychology", "Sociology", "Philosophy", "Literature", "History", "Political Science", "Engineering", "Art History", "Music Theory", "Environmental Science", "Geology", "Statistics", "Business Administration", "Accounting");

$course = $sub[random(0,$#sub,1)];

# HINTS messages for common wrong answers.
@precise = ($steps == 1) ? (68.2, 68.26, 68.27, 68.3) : ($steps == 2) ? (95.4, 95.44, 95.45, 95.5) : ();
$ansCmp = Real($ans)->cmp->withPostFilter(AnswerHints(
    [ map { Real($_) } @precise ] =>
        "That is a more precise value, like one from a z-table. For this problem, use the "
      . "68-95-99.7 rule.",
    Real(100) => "Not quite all of them. Use the 68-95-99.7 rule.",
));

BEGIN_PGML
The scores on the midterm exam for a [$course] course at a large university are normally distributed with a mean score of [$mean] points and a standard deviation of [$stddev] points. What percentage of scores fall between the scores of [$bottom] points and [$top] points?

The answer is [_]{$ansCmp}{5} %
END_PGML

ENDDOCUMENT();
